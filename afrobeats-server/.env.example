# PostgreSQL
# Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

R2_PUBLIC_BUCKET=emokhrr-public
R2_PRIVATE_BUCKET=emokhrr-private

# Paystack
PAYSTACK_SECRET_KEY=

# Admin authentication
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=

# Application
PORT=5000
FRONTEND_URL=http://localhost:5173